#!/sbin/sh
umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() { echo "$1"; }

# Locate util_functions.sh — walk Magisk, KernelSU, APatch paths in order
UTIL_PATH=""
for path in \
  /data/adb/magisk/util_functions.sh \
  /data/adb/ksu/util_functions.sh \
  /data/adb/ap/util_functions.sh \
  /data/adb/modules/util_functions.sh; do
  [ -f "$path" ] && { UTIL_PATH="$path"; break; }
done

# Fallback: recovery environment — try mounting /data then retry
if [ -z "$UTIL_PATH" ]; then
  mount /data 2>/dev/null
  mount /system 2>/dev/null
  for path in \
    /data/adb/magisk/util_functions.sh \
    /data/adb/ksu/util_functions.sh \
    /data/adb/ap/util_functions.sh; do
    [ -f "$path" ] && { UTIL_PATH="$path"; break; }
  done
fi

if [ -n "$UTIL_PATH" ]; then
  . "$UTIL_PATH"
else
  ui_print "***************************************************"
  ui_print "! Cannot find root manager environment!"
  ui_print "! Install via Magisk, KernelSU, or APatch."
  ui_print "***************************************************"
  exit 1
fi

install_module
exit 0
